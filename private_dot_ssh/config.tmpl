# Example: Bastion/jump host pattern
# Host bastion
#   HostName bastion.company.com
#   User your-username
#   IdentityFile ~/.ssh/id_ed25519_work
#   ForwardAgent no

# Host internal-*
#   ProxyJump bastion
#   User ubuntu
#   IdentityFile ~/.ssh/id_ed25519_work

# ControlPath uses ~/.ssh directly; no extra directory needed
